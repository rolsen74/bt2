ARCHIVE ?= $(CURDIR)/bt2.lha

.PHONY: all build_archive

all: build_archive

build_archive:
	$(MAKE) -f makefile BINDIR=bin
	$(MAKE) -C Programs/BluetoothPrefs
	@set -eu; \
	archive="$(abspath $(ARCHIVE))"; \
	stage=$$(mktemp -d "$$(dirname "$$archive")/.bt2-archive.XXXXXX"); \
	trap 'rm -rf "$$stage"' 0; \
	mkdir -p "$$stage/bt2/Kickstart" "$$stage/bt2/Prefs"; \
	cp bin/bluetooth2.kmod "$$stage/bt2/Kickstart/"; \
	cp Programs/BluetoothPrefs/bin/Bluetooth2 Programs/BluetoothPrefs/Bluetooth2.info "$$stage/bt2/Prefs/"; \
	cp ThirdParty/libsbc/LICENSE "$$stage/bt2/libsbc.license"; \
	(cd "$$stage" && lha a bt2.lha bt2 && lha t bt2.lha); \
	mv -f "$$stage/bt2.lha" "$$archive"
